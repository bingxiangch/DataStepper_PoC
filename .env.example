# Copy this file to .env and fill in only the provider you intend to use.
# .env is git-ignored. Never commit API keys.

# Live Agent mode is optional. Scripted mode works without any key.
# Accepted values: anthropic | openai. If omitted, the provider is inferred
# from whichever API key is present.
LLM_PROVIDER=

# Optional model override. Defaults to claude-sonnet-5-5 for Anthropic and
# gpt-4o-mini for OpenAI-compatible providers.
LLM_MODEL=

# Provide exactly one of these for Live mode. Leave both empty to keep Live
# visibly unavailable in the UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Used only when LLM_PROVIDER=openai. Point this at a compatible endpoint if needed.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional path overrides. Relative paths resolve against the process working
# directory. Defaults: ./data/olist and ./runs.
# OLIST_DATA_DIR=./data/olist
# RUNS_DIR=./runs

# Optional artificial delay (seconds) before each tool operation. Useful when
# demonstrating Continue/Pause. 0 (the default) means real execution speed.
DEBUGGER_OPERATION_DELAY=0
